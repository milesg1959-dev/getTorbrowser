. rc.privoxy

# 无参数
[[ $# -lt 1 ]] && privoxy_usage

# 第一个参数...
is_number "$1"
# 参数必须是字符串
[[ $? -eq 0 ]] && {
  echo "Invalid parameter $1"
  privoxy_usage
}
item_in_list "$1" "${PRIVOXY_SIGNALS[*]}"
[[ $? -ne 0 ]] && {
  echo "Invalid parameter $1"
  echo
  privoxy_usage
}
PRIVOXY_SIGNAL="$1"

privoxy_signal_handling

exit $?

