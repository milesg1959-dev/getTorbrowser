. rc.onion

# 无参数
[[ $# -lt 1 ]] && tor_usage

# 第一个参数...
is_number "$1"
# 参数一必须是字符串
[[ $? -eq 0 ]] && {
  echo "Invalid parameter $1"
  tor_usage
}
item_in_list "$1" "${TOR_SIGNALS[*]}"
[[ $? -ne 0 ]] && {
  echo "Invalid parameter $1"
  echo
  tor_usage
}
TOR_SIGNAL="$1"

# 第二个参数...
[[ $# -ge 2 ]] && {
  # 有第二个参数...
  is_number "$2"
  [[ $? -eq 0 ]] && {
    # 参数二是数字
    [[ "$2" -lt 1 ]] && {
      echo "Invalid parameter $2"
      echo
      tor_usage
    }
    [[ "$2" -gt $TOR_INSTANCES_MAX ]] && TOR_INSTANCES=$TOR_INSTANCES_MAX  || TOR_INSTANCES=$2
  } || {
    case "$2" in
      torbrowser)  # 参数二是torbrowser
        TOR_INSTANCES=$TOR_INSTANCES_TORBROWSER
        ;;
      all)  # 参数二是all
        TOR_INSTANCES=$TOR_INSTANCES_MAX
        ;;
      *)  # 参数二是其它值
        echo "Invalid parameter $2"
        echo
        tor_usage
        ;;
    esac
  }
} || {
  # 没有第二个参数, default Tor service.
  TOR_INSTANCES=0
}

tor_instance_handling

exit $?

