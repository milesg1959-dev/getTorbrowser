##
# 判断参数是否与数组中某项完全相等的函数
##
item_in_list() {
  local item=$1
  local list=($2)
  local in_list=false
  for item1 in "${list[@]}"; do
    [[ $item1 == $item ]] && {
      in_list=true
      break
    }
  done
  [[ $in_list == true ]] && return 0 || return 1
}
