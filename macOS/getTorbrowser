. rc.onion
. rc.privoxy

gettorbrowser_signals=( --list --fetch --create --install --help )

dl_folder=$HOME/Downloads/Torbrowser
teb_folder=$PWD/tor-expert-bundle
update_folder=$PWD/Update
bak_folder=$update_folder/$(date +%Y%m%d%H%M)_bak

# By default, dist_url is: Torbrowser's official site
dist_url="https://dist.torproject.org/torbrowser/"
site_list="site_list.txt"
select_dist_url () {
# Select dist_url
# return $?
  # Save the original default delimiter of the system
  IFS_OLD="${IFS}"
  # Set new delimiter
  IFS=$'\r\n'
  num=0
  while read site;
  do
    [[ "$site" != "#"* ]] && {
      sites[$num]=${site}
      num=`expr $num + 1`
    }
  done < $site_list
  # Restore the original default delimiter of the system
  IFS=${IFS_OLD}
  unset menu_result
  sc_menu "Please choose a site from the list" "----------------------------------" "${sites[*]}"
  [[ "($menu_result)" != "https://www.torproject.org" ]] && dist_url=$menu_result/dist/torbrowser/
  test_url $dist_url
  return $?
}

# check wget
WGETBIN=$(GetCMD wget)
[[ "${WGETBIN}" == "" ]] && {
  echo "Sorry, you haven't installed wget yet."
  echo "Please refer to the readme.md for the solution."
  echo
  exit 1
}

# By default, wget does not use a proxy.
wget_spider="wget -q -t 1 --spider --no-check-certificate"
wget_dl="wget -q -c -t 0 -P"

# By default, Tor & Privoxy are not started.
torprivoxy=off
start_torprivoxy () { # Start Tor & Privoxy, Add proxy settings for wget, return 0
  echo "Start Tor & Privoxy."
  echo
  TOR_SIGNAL=start
  TOR_INSTANCES=0
  tor_instance_handling
  [[ $? -ne 0 ]] && {
    echo Error starting Tor
    echo
    return 1
  }
  PRIVOXY_SIGNAL=start
  privoxy_signal_handling
  [[ $? -ne 0 ]] && {
    echo Error starting Privoxy
    echo
    return 1
  }
  torprivoxy=on
  wget_spider="wget -e https_proxy=127.0.0.1:8118 -q -t 1 --spider --no-check-certificate"
  wget_dl="wget -e https_proxy=127.0.0.1:8118 -q -c -t 0 -P"
  return 0
}
stop_torprivoxy () { # Stop Tor & Privoxy, Remove proxy settings for wget, return 0
  echo "Stop Tor & Privoxy."
  echo
  TOR_SIGNAL=stop
  TOR_INSTANCES=0
  tor_instance_handling
  [[ $? -ne 0 ]] && {
    echo Error stopping Tor
    return 1
  }
  PRIVOXY_SIGNAL=stop
  privoxy_signal_handling
  [[ $? -ne 0 ]] && {
    echo Error stopping Privoxy
    return 1
  }
  torprivoxy=off
  wget_spider="wget -q -t 1 --spider --no-check-certificate"
  wget_dl="wget -q -c -t 0 -P"
  return 0
}

test_url () {
# Test the url, Turn on the tor & privoxy switch when necessary.
# When the tor & privoxy switch is turned on, if the test url fails more than three times, exit.
# $1 url return 0/1
  echo "Let's try to test whether $1 can be accessed..."
  echo
  echo "$wget_spider $1"
  echo
  $wget_spider $1
  [[ $? -ne 0 ]] && {
    echo
    echo "The $1 cannot be accessed, Let's turn on the tor & privoxy"
    echo
    start_torprivoxy
    [[ $? -ne 0 ]] && return $?
    # Test proxy
    echo "Test $1 again..."
    echo
    proxy_ok="false"
    num=0
    until [[ "$proxy_ok" == "true" || "$num" == "5" ]];
    do
      echo "$wget_spider $1"
      echo
      $wget_spider $1
      [[ $? -eq 0 ]] && proxy_ok="true"
      num=`expr $num + 1`
    done
    echo "$num"
    [[ "$proxy_ok" == "false" ]] && {
      echo "The $1 cannot be accessed, Please check your network!"
      echo
      stop_torprivoxy
      return 1
    }
  }
  echo "Okey, The $1 can be accessed." 
  echo
  return 0
}

index="index.html"
get_index () { # $1 url
  echo "$wget_dl . $1"
  echo
  $wget_dl . $1
  return $?
}

# Specify_version
# Latest_version
# Do you need the latest version or a specific version?
# Do you need the latest version of the software or a specific version?
#
available_version=()
latest_version="0"
specific_version="0"
get_available_version () {
# Get available version, latest version, specific version is the same as the latest version
# return 0
  # Save the original default delimiter of the system
  IFS_OLD="${IFS}"
  # Set new delimiter
  IFS=$'\r\n'
  num=0
  while read line;
  do
    [[ "$line" =~ "<a href=" ]] && {
      line=${line#*href=\"} ## first "<a href=" from left to right
      line=${line%%/\"*}    ## last "<a href=" from right to left
      # [[ "${line}" == "${line//[a-z_,A-Z_]}" ---- Exclude Beta version
      # || "${line}" =~ ".." || "${line}" =~ "/" || "${line}" =~ "?C=D;O=A" || "${line}" =~ "?C=N;O=D" || "${line}" =~ "dist" || "${available_version[@]}" =~ "${line}" ]] || {
      [[ "${line}" =~ ".." || "${line}" =~ "/" || "${line}" =~ "?C=D;O=A" || "${line}" =~ "?C=N;O=D" || "${line}" =~ "dist" || "${available_version[@]}" =~ "${line}" ]] || {
        available_version[$num]=$line
        num=`expr $num + 1`
      }
    }
  done < $index
  for ver in "${available_version[@]}";
  do
    version_compare $latest_version $ver >/dev/null 2>&1
    [[ $? -eq 1 ]] && latest_version=$ver
  done
  specific_version=$latest_version
  # Restore the original default delimiter of the system
  IFS=${IFS_OLD}
  delete_file $index
  return 0
}
get_specific_version () {
# Get specific version from available version list 
# return 0
  unset menu_result
  sc_menu "Please choose a version from the list" "-------------------------------------" "${available_version[*]}"
  [[ "${menu_result}" != "$specific_version" ]] && specific_version="${menu_result}"
  return 0
}

# all_platforms and some_platforms
# Do we need specific platforms or all platforms?
# Do you need software for all platforms or just for certain platforms?
#
all_platforms=("full")
all_platforms_num="0"
specific_platforms=()
platform_list="platform_list.txt"
select_platforms () { # Select the platforms, multiple answers can be entered
  # Save the original default delimiter of the system
  IFS_OLD="${IFS}"
  # Set new delimiter
  IFS=$'\r\n'
  num=0
  while read line;
  do
    [[ "$line" != "#"* ]] && {
      pfs[$num]=$line
      num=`expr $num + 1`
    }
  done < $platform_list
  all_platforms_num=`expr $num - 1`
  # Restore the original default delimiter of the system
  IFS=${IFS_OLD}
  unset menu_result
  mc_menu "Which platforms' Torbrowser do you need to download?" "(Please enter all the platform numbers you need at once, separated by spaces or commas.)" "${pfs[*]}"
  [[ "${menu_result[@]}" =~ "$all_platforms" || "${#menu_result[@]}" == "$all_platforms_num" ]] && specific_platforms=$all_platforms || specific_platforms=${menu_result[*]}
  return 0
}

all_platforms_dl_list=()
specific_platforms_dl_list=()
create_all_platforms_dl_list () {
# Create the all_platform_dl_list, specific_platform_dl_list is the same as the all_platform_dl_list
# $1 dist_url, $2 specific_version
  # Save the original default delimiter of the system
  IFS_OLD="${IFS}"
  # Set new delimiter
  IFS=$'\r\n'
  num=0
  while read line;
  do
    [[ "$line" =~ "<a href=" ]] && {
      line=${line#*href=\"} # first href=
      line=${line%%\"*} # last /\"
      [[ "${line}" =~ ".." || "${line}" =~ "/" || "${line}" =~ "?C=D;O=A" || "${line}" =~ "?C=N;O=D" || "${line}" =~ "dist" || "${line}" =~ "geckodriver-" || "${line}" =~ "mar" || "${line}" =~ "incrementals" || "${line}" =~ "-unsigned-" || "${line}" =~ "src-" || "${line}" =~ "-debug-symbols-" || "${line}" =~ "-unsign-" ]] || {
        all_platforms_dl_list[$num]=$1$2/$line
        specific_platforms_dl_list[$num]=$1$2/$line
        num=`expr $num + 1`
      }
    }
  done < $index
  # Restore the original default delimiter of the system
  IFS=${IFS_OLD}
  delete_file $index
  return 0
}
create_specific_platforms_dl_list () {
# Create the specific_platforms_dl_list from all_platforms_dl_list by select_platforms
# return 0
  [[ "${specific_platforms}" =~ "${all_platforms}" ]] || {
    unset specific_platforms_dl_list
    num=0
    for line in "${all_platforms_dl_list[@]}";
    do
      already_added=0
      for pf in $specific_platforms;
      do
        [[ "${already_added}" == "0" && "${line}" =~ "sha256sums-signed" || "${line}" =~ "${pf}" ]] && {
          specific_platforms_dl_list[$num]=$line
          num=`expr $num + 1`
          already_added=1
        }
      done
    done
  }
  return 0
}

local_tor_expert_bundle_version=""
local_tor_expert_bundle_version_file=$teb_folder/teb_version
check_local_tor_expert_bundle () {
# Check if the Tor Expert Bundle exists locally, get the version
# return $?
  echo "Check if the local Tor Expert Bundle exists ..."
  echo
  check_file $local_tor_expert_bundle_version_file
  [[ $? -ne 0 ]] && {
    echo "Local Tor Expert Bundle not found."
    echo
    return 1
  }
  for str in `cat "$local_tor_expert_bundle_version_file"`
  do
    local_tor_expert_bundle_version="$str"
  done
  echo "Local Tor Expert Bundle has been found, the version is: $local_tor_expert_bundle_version"
  echo
  return 0
}

local_tor_expert_bundle_package_version=""
local_tor_expert_bundle_package_file=""
check_local_tor_expert_bundle_package () {
# Check if the Tor Expert Bundle package exists locally, get the version & filename
# return $?
  echo "Check if the local Tor Expert Bundle package exists ..."
  echo
  for local_tor_expert_bundle_package_file in `ls -Rrt $dl_folder/*/tor-expert-bundle-macos-$machine_arch-*.tar.gz 2>/dev/null`
  do
    echo -e ". \c"
  done
  echo
  echo
  check_file $local_tor_expert_bundle_package_file
  [[ $? -ne 0 ]] && {
    echo "Local Tor Expert Bundle package not found."
    echo
    return 1
  }
  local_tor_expert_bundle_package_version=${local_tor_expert_bundle_package_file##*/}
  local_tor_expert_bundle_package_version=${local_tor_expert_bundle_package_version##*"-"}
  local_tor_expert_bundle_package_version=${local_tor_expert_bundle_package_version%".tar"*}
  echo "Found some local Tor Expert Bundle package, the latest version is: $local_tor_expert_bundle_package_version"
  echo
  echo "  $local_tor_expert_bundle_package_file"
  echo
  return 0
}

list_torbrowsers () {
# List the available Torbrowsers (including Tor Expert Bundle)
# return $?
  echo "Finding available Torbrowsers"
  echo
  select_dist_url
  [[ $? -ne 0 ]] && return $?
  get_index $dist_url
  [[ $? -ne 0 ]] && {
    echo "The information of available Torbrowsers cannot be obtained!"
    return 1
  }
  get_available_version
  echo "Found the following available Torbrowsers:"
  echo
  for ver in "${available_version[@]}";
  do
    # echo $ver >> $available_torbrowsers_list
    echo "* Title: Torbrowser, Version: $ver"
  done
  echo
  echo "The latest available Torbrowser version is: $latest_version"
  echo
  return 0
}
download_torbrowser () {
# Download the latest recommended (or specific version) Torbrowser
# return $?
  list_torbrowsers
  [[ $? -ne 0 ]] && return $?
  get_specific_version
  get_index $dist_url$specific_version/
  [[ $? -ne 0 ]] && {
    echo "The information of Torbrowser $specific_version cannot be obtained!"
    return 1
  }
  create_all_platforms_dl_list $dist_url $specific_version
  select_platforms
  create_specific_platforms_dl_list
  create_folder $dl_folder/$specific_version
  [[ $? -ne 0 ]] && return 1
  delete_file $dl_folder/$specific_version/$specific_version.txt
  for ver in "${specific_platforms_dl_list[@]}";
  do
    echo $ver >> $dl_folder/$specific_version/$specific_version.txt
    echo "$wget_dl $dl_folder/$specific_version/ $ver"
    $wget_dl $dl_folder/$specific_version/ $ver
  done
  check_file $dl_folder/$specific_version/$specific_version.txt
  [[ $? -ne 0 ]] && return $?
  echo
  echo "All file has been downloaded. Enjoy!"
  echo
  return 0
}
create_download_list () {
# Create a download item list file for the latest recommended (or specific version) Torbrowser
# return $?
  list_torbrowsers
  [[ $? -ne 0 ]] && return $?
  get_specific_version
  get_index $dist_url$specific_version/
  [[ $? -ne 0 ]] && {
    echo "The information of Torbrowser $specific_version cannot be obtained!"
    return 1
  }
  create_all_platforms_dl_list $dist_url $specific_version
  select_platforms
  create_specific_platforms_dl_list
  create_folder $dl_folder/$specific_version
  [[ $? -ne 0 ]] && return 1
  delete_file $dl_folder/$specific_version/$specific_version.txt
  for ver in "${specific_platforms_dl_list[@]}";
  do
    echo $ver >> $dl_folder/$specific_version/$specific_version.txt
  done
  check_file $dl_folder/$specific_version/$specific_version.txt
  [[ $? -ne 0 ]] && return $?
  echo
  echo "The download item list file has been saved. Enjoy!"
  echo
  return 0
}
install_tor_expert_bundle () {
# Install / Update the local Tor Expert Bundle
# return $?
  update=0
  title=("Install" "Update")
  check_local_tor_expert_bundle
  [[ $? -eq 0 ]] && update=1
  check_local_tor_expert_bundle_package
  [[ $? -ne 0 ]] && {
    echo "You can use the fetch command to download the latest version of Tor Expert Bundle package."
    echo
    return 1
  }
  [[ "${update}" == "1" ]] && {
    version_compare $local_tor_expert_bundle_version $local_tor_expert_bundle_package_version
    [[ $? -eq 0 || $? -eq 2 ]] && {
      echo "It's already the latest version, no need to update."
      return 0
    }
    echo "${title[$update]} local Tor Expert Bundle, please wait ..."
    echo
    renew_folder $bak_folder
    [[ $? -ne 0 ]] && {
      echo "Failed to create $bak_folder folder!"
      echo
      echo "${title[$update]} cancelled."
      echo
      return 1
    }
    echo "Backup old files to $bak_folder ..."
    echo
    mv -f $teb_folder $bak_folder >/dev/null 2>&1
    [[ $? -ne 0 ]] && {
      echo "Backup file failed!"
      echo
      echo "${title[$update]} cancelled."
      echo
      return 1
    }
    echo "Copy new file ..."
    echo
  } || {
    echo "${title[$update]} local Tor Expert Bundle, please wait ..."
    echo
  }
  create_folder $teb_folder
  [[ $? -ne 0 ]] && {
    echo "Failed to create $teb_folder folder!"
    echo
    echo "${title[$update]} cancelled."
    echo
    return 1
  }
  tar -xvf $local_tor_expert_bundle_package_file -C $teb_folder 2>/dev/null
  [[ $? -ne 0 ]] && {
    echo "Failed to decompress local Tor Expert Bundle package!"
    echo
    echo "${title[$update]} cancelled."
    echo
    return 1
  }
  cat <<EOF > $local_tor_expert_bundle_version_file
$local_tor_expert_bundle_package_version
EOF
  echo "Done."
  echo
  echo "${title[$update]} completed. Enjoy!"
  echo
  return 0
}

usage () {
  cat <<EOF
Usage: $BASENAME {--list|--fetch|--create|--install|--help}

Generic action handler are:

  --list    List the available Torbrowsers
  --fetch   Download the latest recommended (or specific version) Torbrowser
  --create  Create a download item list file for the latest recommended (or specific version) Torbrowser
  --install Install / Update the latest recommended Tor Expert Bundle
  --help    Print this help

EOF
  exit 1
}

# 无参数
[[ $# -lt 1 ]] && usage

# 第一个参数...
is_number "$1"
# 参数必须是字符串
[[ $? -eq 0 ]] && {
  echo "Invalid parameter $1"
  usage
}
item_in_list "$1" "${gettorbrowser_signals[*]}"
[[ $? -ne 0 ]] && {
  echo "Invalid parameter $1"
  echo
  usage
}

##
# Generic action handler
##
case "$1" in
  --list    ) list_torbrowsers;;
  --fetch   ) download_torbrowser;;
  --create  ) create_download_list;;
  --install ) install_tor_expert_bundle;;
  --help    ) usage;;
  *         ) usage;;
esac

[[ "$torprivoxy" == on ]] && stop_torprivoxy

exit $?

